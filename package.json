{
  "name": "gamebridge",
  "version": "0.4.0",
  "description": "A modern launcher for Unity, Unreal, and custom game engines.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Joseph Cook",
  "license": "PolyForm-Shield-1.0.0",
  "homepage": "https://github.com/CookieJarTools/GameBridge",
  "desktopName": "gamebridge.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:banner": "electron scripts/render-banner.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.gamebridge.launcher",
    "productName": "GameBridge",
    "directories": {
      "buildResources": "build",
      "output": "dist/${version}"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GameBridge-Setup-${version}.${ext}",
      "license": "LICENSE.md",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameBridge",
      "uninstallDisplayName": "GameBridge",
      "runAfterFinish": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Launcher for Unity, Unreal, and custom game engines",
      "maintainer": "Joseph Cook",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "appImage": {
      "artifactName": "GameBridge-${version}.AppImage"
    },
    "pacman": {
      "artifactName": "GameBridge-${version}-x86_64.pkg.tar.xz",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "xdg-utils",
        "libarchive"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
